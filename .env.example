# OpenAI API Key (required for menu analysis with GPT-4 Vision)
OPENAI_API_KEY=sk-...

# Google Gemini API Key (required for dish image generation)
GEMINI_API_KEY=...

# Optional: Base URL for the application
APP_BASE_URL=http://localhost:3000

# Optional: Set to "true" to enable mock mode (useful for development without API keys)
MOCK_MODE=false
